# ATLAS - Ubuntu bare metal + Tesla T4 / Qwen3-14B
#
# Backend nativo:
#   cp .env.example backend/.env
#
# Docker Compose:
#   cp .env.example .env
#
# Antes de iniciar, cambie SECRET_KEY, POSTGRES_PASSWORD y las URLs si
# accederá desde otra computadora.

# Aplicación y seguridad
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7860
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:7860

# PostgreSQL 16 + pgvector
# Estas variables crean la base y el usuario cuando se usa Docker Compose.
POSTGRES_DB=atlas
POSTGRES_USER=atlasUser
POSTGRES_PASSWORD=replace-with-a-database-password

# Para backend nativo, PostgreSQL está publicado en localhost.
# Docker Compose sustituye esta URL dentro de sus contenedores.
DATABASE_URL=postgresql+psycopg://atlasUser:replace-with-a-database-password@localhost:5432/atlas
CORPUS_STORE_BACKEND=postgres

# Almacenamiento e ingesta
UPLOAD_DIR=./data/uploads
GRAPH_PERSIST_DIR=./data/graphs
CELERY_ENABLED=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/0
PDF_EXTRACTION_MODE=auto

# ATLAS ejecuta recuperación en el Xeon; Ollama utiliza la Tesla T4 local.
MODEL_PROFILE=ubuntu_t4
DEVICE=cpu
CPU_THREADS=28

# LLM servido por Ollama
LLM_MODEL=qwen3:14b-q4_K_M
LLM_CONTEXT_WINDOW=8192
LLM_MAX_NEW_TOKENS=3072
LLM_REQUEST_TIMEOUT_SECONDS=900
LLM_DISABLE_THINKING=True
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m

# Embeddings en CPU; mantener dimensión y versión sincronizadas.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_INDEX_VERSION=hierarchical-qwen3-1024-v1
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64

# Reranker en CPU para no competir por los 16 GB de VRAM de la T4.
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=cpu
RERANK_MAX_LENGTH=1024

# Recuperación e investigación
TOP_K_RETRIEVAL=30
TOP_K_RERANK=12
AGENT_PLANNER_MAX_TOKENS=384
AGENT_SYNTHESIS_MAX_TOKENS=2048
RESEARCH_MAX_ROUNDS=2
RESEARCH_TIMEOUT_SECONDS=1800
RESEARCH_SYNTHESIS_RESERVE_SECONDS=600
RESEARCH_MAX_FACETS=5
