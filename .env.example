# ATLAS - Tesla T4 / Qwen3-14B
#
# Backend nativo:
#   cp .env.example backend/.env
#
# Docker Compose:
#   cp .env.example .env
#
# Antes de iniciar, cambie SECRET_KEY, POSTGRES_PASSWORD y las URLs si
# accederá desde otra computadora.

# Aplicación y seguridad
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7860
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:7860

# PostgreSQL 16 + pgvector
# Estas variables crean la base y el usuario cuando se usa Docker Compose.
POSTGRES_DB=atlas
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=admin6767

# Para backend nativo, PostgreSQL está publicado en localhost.
# Docker Compose sustituye esta URL dentro de sus contenedores.
DATABASE_URL=postgresql+psycopg://atlas_user:admin6767@localhost:5432/atlas
CORPUS_STORE_BACKEND=postgres

# Almacenamiento e ingesta
UPLOAD_DIR=./data/uploads
CELERY_ENABLED=False
PDF_EXTRACTION_MODE=auto

# ATLAS corre en WSL sobre CPU; Ollama para Windows utiliza la Tesla T4.
MODEL_PROFILE=custom
DEVICE=cpu
CPU_THREADS=0

# LLM servido por Ollama
LLM_MODEL=qwen3:14b-q4_K_M
LLM_CONTEXT_WINDOW=8192
LLM_MAX_NEW_TOKENS=3072
LLM_REQUEST_TIMEOUT_SECONDS=900
LLM_DISABLE_THINKING=True

# Embeddings en CPU; mantener dimensión y versión sincronizadas.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_INDEX_VERSION=hierarchical-qwen3-1024-v1
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Reranker en CPU para no competir por los 16 GB de VRAM de la T4.
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=cpu
RERANK_MAX_LENGTH=1024

# Recuperación e investigación
TOP_K_RETRIEVAL=30
TOP_K_RERANK=12
AGENT_PLANNER_MAX_TOKENS=384
AGENT_SYNTHESIS_MAX_TOKENS=2048
RESEARCH_MAX_ROUNDS=2
RESEARCH_TIMEOUT_SECONDS=1800
RESEARCH_SYNTHESIS_RESERVE_SECONDS=600
RESEARCH_MAX_FACETS=5

# ── Skills del agente ─────────────────────────────────────────────────────
# Directorio escaneado en busca de `<nombre-skill>/SKILL.md`. El agente ReAct
# las descubre y carga bajo demanda con la herramienta `use_skill`: los nombres
# y descripciones (nivel 1) van embebidos en la descripción de la herramienta,
# y solo el cuerpo de la skill elegida (nivel 2) se carga al llamarla.
# Ver backend/app/rag/skills.py y docs/AGENT_LOOPS.md §4.3.
SKILLS_DIR=./app/rag/skills

# ── Modo Revisión de Código ───────────────────────────────────────────────
# routing_mode="code_review" fuerza un bucle exterior Percibe-Razona-Actúa
# (backend/app/rag/code_review_agent.py) que envuelve su propio ejecutor ReAct.
# Es de solo lectura/asesoría: nunca escribe ni modifica archivos.
#
# Los presupuestos están desacoplados a propósito de AGENT_MAX_ITERATIONS, para
# que ajustar un bucle no cambie en silencio el del otro. Detalle en
# docs/AGENT_LOOPS.md §4.
# Rondas exteriores (rango válido 1-5).
CODE_REVIEW_MAX_ROUNDS=3
# Reloj de pared del bucle completo, en segundos (rango válido 30-7200).
CODE_REVIEW_TIMEOUT_SECONDS=900
# Pasos ReAct dentro de cada ronda (rango válido 1-10).
CODE_REVIEW_MAX_ITERATIONS_PER_ROUND=5

# Herramientas MCP — el agente de chat (ReAct) puede usar herramientas MCP
# (Model Context Protocol) además de sus herramientas internas (pdf_search,
# web_search, calculator, statistics, code_review, use_skill). Sin servidores en
# MCP_SERVERS_JSON, load_mcp_tools() no carga nada y el agente sigue funcionando
# igual que antes.
#
# El ejemplo de abajo conecta un servidor MCP de sistema de archivos de SOLO
# LECTURA, limitado al directorio de subidas (debe coincidir con UPLOAD_DIR de
# arriba), para que el agente pueda listar/leer los PDFs ya subidos como
# evidencia adicional. Requiere Node.js/npx (ya incluido en el Dockerfile).
#
# Los argumentos de "args" se expanden con os.path.expanduser/expandvars antes
# de arrancar el servidor MCP (ver config.py), así que "~" y variables como
# "$HOME" son portables: se resuelven al usuario/carpeta real de quien corre
# la app, no a un usuario fijo. Para dar acceso también a carpetas comunes del
# usuario, agrega más rutas al array de "args", p. ej.:
#   "args": ["-y","@modelcontextprotocol/server-filesystem","./data/uploads","~/Documents","~/Desktop","~/Downloads"]
# NUNCA hardcodees una ruta absoluta de un usuario específico (p. ej.
# "/Users/tu-nombre/Documents") — usa "~" para que funcione en cualquier
# máquina.
MCP_ENABLED=True
MCP_SERVERS_JSON={"filesystem":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./data/uploads"]}}
# Solo nombres de herramientas de solo lectura. NUNCA agregues write_file,
# edit_file, delete_file, move_file o create_directory aquí — el chat agent no
# debe poder modificar archivos. MCP_TOOL_DENYLIST las bloquea explícitamente
# como defensa adicional (coincidencia exacta de nombre de herramienta).
MCP_TOOL_ALLOWLIST=read_file,list_directory,list_allowed_directories,file_exists,get_file_info
MCP_TOOL_DENYLIST=write_file,edit_file,delete_file,move_file,create_directory
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_MAX_RESULT_CHARS=6000

# ── Trazabilidad del razonamiento (Langfuse autoalojado) ──────────────────
# Opcional y desactivado por defecto. Traza el grafo de investigación
# (understand → retrieve → ledger → audit → outline → draft → verify →
# repair → finalize) y el bucle ReAct, con latencia y tokens por etapa.
#
# Levanta el stack con:
#   docker compose -f docker-compose.langfuse.yml up -d
# y crea un proyecto en http://localhost:3001 para obtener las claves.
#
# El puerto es 3001 y no 3000 porque el frontend Next.js ya usa 3000 en local.
#
# Si el host no responde, las trazas se descartan en silencio: el tracing nunca
# bloquea ni rompe una respuesta del chat (ver docs/OBSERVABILITY.md).
LANGFUSE_ENABLED=False
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
# Fracción de trazas enviadas (1.0 = todas). Bájala si el volumen molesta.
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_DEBUG=False

# ── Identificadores académicos (DOI) en citas web ─────────────────────────
# Un DOI escrito literalmente en la URL o el snippet siempre se usa (sin red).
# Este interruptor solo controla la consulta a Crossref, que cuesta una llamada
# de red y únicamente se intenta para hosts académicos conocidos que no
# declararon DOI. Crossref siempre responde con su mejor candidato, así que el
# DOI solo se acepta si su título coincide con el de la fuente: un DOI
# equivocado es peor que ninguno (ver backend/app/rag/scholarly.py).
DOI_CROSSREF_LOOKUP=True
DOI_CROSSREF_TIMEOUT_SECONDS=5
